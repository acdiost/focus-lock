{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusLock",
  "version": "2.1.1",
  "identifier": "com.acdiost.focuslock",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Focus Lock",
        "width": 1180,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Pomodoro timer with break-time screen lock",
    "longDescription": "Focus Lock is a Pomodoro timer that covers all displays during breaks, helping you take proper rest and stay focused.",
    "copyright": "© 2026 acdiost",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null,
      "hardenedRuntime": false,
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 320
        },
        "appPosition": {
          "x": 130,
          "y": 150
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 150
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libgtk-3-0"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
