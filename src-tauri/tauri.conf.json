{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Focus Lock",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "identifier": "com.acdiost.focuslock",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "targets": ["dmg"],
      "category": "Productivity",
      "shortDescription": "Pomodoro timer with break-time screen lock",
      "longDescription": "Focus Lock is a Pomodoro timer that covers all displays during breaks, helping you take proper rest and stay focused.",
      "copyright": "© 2026 acdiost",
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "10.15",
        "signingIdentity": null,
        "entitlements": null,
        "hardenedRuntime": false
      },
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 320
        },
        "appPosition": {
          "x": 130,
          "y": 150
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 150
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Focus Lock",
        "width": 1180,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
